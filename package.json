{
  "name": "pi-ds4",
  "version": "0.4.1",
  "description": "Pi provider and native-agent launcher for deterministic local ds4.c DeepSeek V4 Flash inference (audreyt fork: cyberneurova abliterated aligned-imatrix GGUF + audreyt/ds4 main).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "og:render": "node scripts/render-og-image.mjs",
    "og:check-render": "node scripts/render-og-image.mjs --check",
    "og:verify": "node scripts/verify-og-image.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "ds4",
    "deepseek",
    "cyberneurova",
    "abliterated",
    "m5"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "ds4-watchdog.sh",
    "install-pi-extension-local.sh",
    "download_model.sh",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}

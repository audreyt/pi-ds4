{
  "name": "pi-ds4",
  "version": "0.7.3",
  "description": "Pi provider and native-agent launcher for deterministic local ds4.c DeepSeek V4.1 Flash inference on 128 GB Apple Silicon (pinned Maya-XS abliterated GGUF and vision sidecar).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "og:render": "node scripts/render-og-image.mjs",
    "og:check-render": "node scripts/render-og-image.mjs --check",
    "og:verify": "node scripts/verify-og-image.mjs",
    "provider:verify": "bun scripts/verify-provider.mjs",
    "download:verify": "bun scripts/verify-download.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "ds4",
    "deepseek",
    "deepseek-v4-flash",
    "deepseek-v4.1-flash",
    "vision",
    "abliterated",
    "m5"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "ds4-watchdog.sh",
    "install-pi-extension-local.sh",
    "download_model.sh",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}

{
  "name": "pi-kami",
  "version": "0.8.0",
  "description": "Pi provider for deterministic local inference on Apple Silicon: DeepSeek V4.1 Flash Maya-XS through ds4 on 128 GB Macs and Recursive's Flint through rec on M4 Pro, M5 Pro and M5 Max Macs with 48 GB or more. Formerly pi-ds4.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "og:render": "node scripts/render-og-image.mjs",
    "og:check-render": "node scripts/render-og-image.mjs --check",
    "og:verify": "node scripts/verify-og-image.mjs",
    "provider:verify": "bun scripts/verify-provider.mjs",
    "download:verify": "bun scripts/verify-download.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "ds4",
    "deepseek",
    "deepseek-v4-flash",
    "deepseek-v4.1-flash",
    "vision",
    "abliterated",
    "flint",
    "rec",
    "m5"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "ds4-watchdog.sh",
    "install-pi-extension-local.sh",
    "download_model.sh",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
